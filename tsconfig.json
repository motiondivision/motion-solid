{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./packages/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
